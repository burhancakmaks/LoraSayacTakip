# Production ortamında güçlü ve rastgele bir değer kullanın.
AUTH_SECRET=replace-with-a-long-random-secret

# İsteğe bağlı: İlk yönetici hesabını sunucu açılışında oluşturur.
# MASKI_ADMIN_EMAIL=admin@example.com
# MASKI_ADMIN_NAME=MASKİ Yöneticisi
# MASKI_ADMIN_PASSWORD=replace-with-a-strong-password

# İlk kurulum uzaktan yapılacaksa zorunludur; yerel localhost kurulumunda gerekmez.
# MASKI_SETUP_TOKEN=replace-with-a-one-time-setup-token

# Parola kurtarma uzak sunucudan yapılacaksa zorunludur.
# MASKI_RECOVERY_TOKEN=replace-with-a-secure-recovery-token
